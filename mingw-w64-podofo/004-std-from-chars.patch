Exclude Clang from the MinGW GCC checks to avoid duplicate
std::from_chars/to_chars definitions on CLANG64.

--- a/src/podofo/private/charconv_compat.h
+++ b/src/podofo/private/charconv_compat.h
@@ -22,12 +22,12 @@
 // Older gcc and clang may have not have floating point std::from_chars/std::to_chars
 #if defined(__GNUC__) && ((!defined(__clang__) && __GNUC__ < 10) || (defined(__clang__) && __clang_major__ < 11))
 #define WANT_CHARS_FORMAT
 #endif
-#if (defined(__GNUC__) && !defined(__clang__) && !defined(__MINGW32__) &&  __GNUC__ < 11) || (defined(__MINGW32__) &&  __GNUC__ < 12) || (defined(__clang__) && defined(_LIBCPP_VERSION) && (_LIBCPP_VERSION < 200000)) || defined(FROM_CHARS_APPLE_TARGET_TOO_LOW)
+#if (defined(__GNUC__) && !defined(__clang__) && !defined(__MINGW32__) &&  __GNUC__ < 11) || (defined(__MINGW32__) && !defined(__clang__) && __GNUC__ < 12) || (defined(__clang__) && defined(_LIBCPP_VERSION) && (_LIBCPP_VERSION < 200000)) || defined(FROM_CHARS_APPLE_TARGET_TOO_LOW)
 #define WANT_FROM_CHARS
 #endif
-#if (defined(__GNUC__) && !defined(__clang__) && !defined(__MINGW32__) &&  __GNUC__ < 11) || (defined(__MINGW32__) &&  __GNUC__ < 12) || (defined(__clang__) && !defined(__apple_build_version__) && __clang_major__ < 14) || defined(TO_CHARS_APPLE_TARGET_TOO_LOW)
+#if (defined(__GNUC__) && !defined(__clang__) && !defined(__MINGW32__) &&  __GNUC__ < 11) || (defined(__MINGW32__) && !defined(__clang__) && __GNUC__ < 12) || (defined(__clang__) && !defined(__apple_build_version__) && __clang_major__ < 14) || defined(TO_CHARS_APPLE_TARGET_TOO_LOW)
 #define WANT_TO_CHARS
 #endif
 
 #if defined(WANT_CHARS_FORMAT) || defined(WANT_FROM_CHARS)
